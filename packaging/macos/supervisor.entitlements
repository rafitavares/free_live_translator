<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The app bundle is the responsible process macOS presents in Privacy &
	     Security while its embedded engine captures local caption audio. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>
