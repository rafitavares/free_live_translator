<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<!-- The optional original OpenAI Whisper backend uses Numba/LLVM, whose
	     current macOS allocator changes anonymous memory from writable to
	     executable without MAP_JIT. Keep this exception on the embedded audio
	     engine only; the native supervisor does not receive it. -->
	<key>com.apple.security.cs.allow-unsigned-executable-memory</key>
	<true/>
</dict>
</plist>
