{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Free Live Translator",
  "version": "0.8.0",
  "identifier": "io.github.rafitavares.freelivetranslator",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "control",
        "title": "Free Live Translator",
        "width": 780,
        "height": 720,
        "minWidth": 620,
        "minHeight": 560,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset:; style-src 'self'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "category": "Utility",
    "copyright": "Copyright © 2026 Church Cap contributors; fork © 2026 Rafael Tavares Coutinho",
    "license": "MIT",
    "longDescription": "Free Live Translator: legendas e tradução simultânea locais para palestras, baseado no Church Cap.",
    "shortDescription": "Tradução simultânea local para palestras",
    "publisher": "Free Live Translator",
    "resources": [],
    "targets": [
      "app",
      "dmg",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJGMUUwMjBBNDQ5MDEwOEEKUldTS0VKQkVDZ0lldjl6V1NqYzB2N1A3V2JtbEFqZEI2azIrQ1FrOHRidGQvRDBGTEk4T2I3R08K",
      "endpoints": [
        "https://raw.githubusercontent.com/rafitavares/free_live_translator/main/updates/desktop/{{target}}-{{arch}}/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
